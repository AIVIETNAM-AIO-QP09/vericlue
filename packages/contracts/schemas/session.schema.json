{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vericlue.local/contracts/session.schema.json",
  "title": "Session API",
  "description": "Hợp đồng giữa web xác minh và API phiên (API v1, chốt ở PLAT-04). Người dân KHÔNG BAO GIỜ nhận điểm số hay chữ 'giả mạo' trong bất kỳ phản hồi nào ở file này.\n\nToken: token THEO PHIÊN (HMAC, gắn session_id, hết hạn ~5 phút), gửi trong header 'Authorization: Bearer' ở mọi lần gọi của phiên; không phải token dùng một lần (ADR-0011). Chống phát lại: trong mỗi LƯỢT, mỗi bước (media, signals, finalize, voice) chỉ được nhận một lần; gọi lại → 409; token sai/hết hạn → 401. 'Lượt' = một challenge: finalize trả 'retry' hoặc 'voice_challenge' thì mở lượt mới; đọc lại câu tối đa 1 lần. Mỗi challenge sống 120 giây kể từ lúc cấp. PLAT-04 chỉ khai báo hợp đồng; PLAT-06 cài đặt HMAC, TTL, 409 và máy trạng thái.",
  "$defs": {
    "ColorStep": {
      "type": "object",
      "required": [
        "rgb",
        "hold_ms",
        "transition_ms"
      ],
      "additionalProperties": false,
      "properties": {
        "rgb": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "hold_ms": {
          "type": "integer",
          "minimum": 400,
          "maximum": 650,
          "description": "Mỗi bước dài >= 550 ms (hold + transition), tức <= 1,8 lần đổi màu/giây (ADR-0011)"
        },
        "transition_ms": {
          "type": "integer",
          "const": 150
        }
      }
    },
    "Challenge": {
      "type": "object",
      "description": "Thử thách cho một lượt. dynamic chỉ có ở onboarding/recovery có body tạo phiên; mọi mốc thời gian dùng chung đầu bản ghi. Chuỗi màu giữ cấu hình an toàn hiện hành.",
      "required": [
        "challenge_id",
        "color_sequence"
      ],
      "additionalProperties": false,
      "properties": {
        "challenge_id": {
          "type": "string"
        },
        "baseline_ms": {
          "type": "integer",
          "default": 1000
        },
        "color_sequence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ColorStep"
          },
          "minItems": 8,
          "maxItems": 8
        },
        "capture_at_ms": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "description": "Thời điểm server chọn để chụp ảnh chất lượng cao"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time",
          "description": "Hạn của thử thách này (120 giây kể từ lúc cấp); tách khỏi hạn của token"
        },
        "dynamic": {
          "$ref": "#/$defs/DynamicChallenge"
        }
      }
    },
    "CreateSessionResponse": {
      "type": "object",
      "required": [
        "session_id",
        "token",
        "expires_at",
        "challenge"
      ],
      "additionalProperties": false,
      "properties": {
        "session_id": {
          "type": "string"
        },
        "token": {
          "type": "string",
          "description": "Token HMAC-SHA256 theo phiên, có hạn; gửi Authorization: Bearer. DB chỉ lưu hash token."
        },
        "expires_at": {
          "type": "string",
          "format": "date-time",
          "description": "Hạn của TOKEN (~5 phút). Hạn của thử thách nằm ở challenge.expires_at."
        },
        "challenge": {
          "$ref": "#/$defs/Challenge"
        },
        "purpose": {
          "$ref": "#/$defs/SessionPurpose"
        },
        "nonce": {
          "type": "string"
        }
      }
    },
    "Signals": {
      "type": "object",
      "description": "Tín hiệu do web hoặc app Android đo. Server KHÔNG tin tuyệt đối, sẽ tính lại từ media. Mọi mốc thời gian trong một lần gửi dùng chung một đồng hồ, tính bằng ms; client_quality.clock ghi đồng hồ nào.",
      "required": [
        "color_events",
        "frame_times"
      ],
      "properties": {
        "color_events": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "index",
              "rgb",
              "painted_at"
            ],
            "properties": {
              "index": {
                "type": "integer"
              },
              "rgb": {
                "type": "string"
              },
              "painted_at": {
                "type": "number",
                "description": "Lúc khung màu được vẽ, ms. Web: performance.now() từ requestAnimationFrame. App Android: SystemClock.elapsedRealtime (khung vẽ của Compose, quy về elapsedRealtime)"
              }
            }
          }
        },
        "frame_times": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "capture_time": {
                "type": [
                  "number",
                  "null"
                ],
                "description": "Lúc camera chụp khung, ms, cùng đồng hồ với painted_at. Web: requestVideoFrameCallback captureTime. App Android: timestamp của khung CameraX quy về elapsedRealtime; null nếu không có"
              },
              "presented_frames": {
                "type": "integer"
              },
              "media_time": {
                "type": "number"
              }
            }
          }
        },
        "region_means": {
          "type": "array",
          "description": "Trung vị RGB theo khung cho 5 vùng da + nền (tham khảo)",
          "items": {
            "type": "object"
          }
        },
        "camprobe": {
          "type": "object",
          "properties": {
            "api_tamper_flags": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "constraint_probes": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "device_label": {
              "type": "string"
            },
            "track_settings": {
              "type": "object"
            },
            "track_capabilities": {
              "type": "object"
            },
            "duplicate_frame_ratio": {
              "type": "number"
            }
          }
        },
        "client_quality": {
          "type": "object",
          "description": "Thông tin máy khách để server đánh giá độ tin cậy của mốc thời gian, ví dụ client (web | android), clock (performance.now | elapsedRealtime), timestamp_source, fps"
        },
        "challenge_id": {
          "type": [
            "string",
            "null"
          ],
          "description": "Bắt buộc với phiên có purpose; phải khớp gói hiện hành."
        }
      }
    },
    "StepAck": {
      "type": "object",
      "description": "Phản hồi cho bước tải lên (media, signals): chỉ xác nhận đã nhận, không có kết quả phân tích.",
      "required": [
        "step",
        "received"
      ],
      "additionalProperties": false,
      "properties": {
        "step": {
          "type": "string",
          "enum": [
            "media",
            "signals"
          ]
        },
        "received": {
          "type": "boolean"
        }
      }
    },
    "RetryHint": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        null,
        "MORE_LIGHT",
        "MOVE_CLOSER",
        "MOVE_BACK",
        "FACE_CENTER",
        "HOLD_STILL",
        "QUIET_PLACE",
        "BRIGHTNESS_UP"
      ],
      "description": "Chỉ nói về CHẤT LƯỢNG, không bao giờ nói về giả mạo"
    },
    "FinalizeResponse": {
      "type": "object",
      "required": [
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "pass",
            "retry",
            "review",
            "voice_challenge",
            "deny",
            "recovery_required"
          ]
        },
        "retry_hint": {
          "$ref": "#/$defs/RetryHint"
        },
        "voice_prompt": {
          "type": [
            "string",
            "null"
          ],
          "description": "Câu tiếng Việt cần đọc"
        },
        "attempts_left": {
          "type": "integer"
        },
        "challenge": {
          "$ref": "#/$defs/Challenge",
          "description": "Chỉ có khi status = retry: thử thách mới cho lượt chụp lại"
        },
        "voice_challenge_id": {
          "type": [
            "string",
            "null"
          ],
          "description": "Mã lần đọc, phải gửi lại trong form /voice của phiên có purpose."
        }
      }
    },
    "VoiceResponse": {
      "type": "object",
      "required": [
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "pass",
            "review",
            "voice_challenge",
            "deny"
          ],
          "description": "voice_challenge = đọc sai câu, được đọc lại tối đa 1 lần với câu mới"
        },
        "voice_prompt": {
          "type": [
            "string",
            "null"
          ],
          "description": "Câu mới, chỉ có khi status = voice_challenge"
        },
        "attempts_left": {
          "type": "integer"
        },
        "voice_challenge_id": {
          "type": [
            "string",
            "null"
          ],
          "description": "Mã lần đọc, phải gửi lại trong form /voice của phiên có purpose."
        }
      }
    },
    "OtpRequest": {
      "type": "object",
      "required": [
        "phone"
      ],
      "additionalProperties": false,
      "properties": {
        "phone": {
          "type": "string",
          "pattern": "^0[0-9]{9}$",
          "description": "Số di động Việt Nam 10 số"
        }
      }
    },
    "OtpSent": {
      "type": "object",
      "required": [
        "expires_at",
        "attempts_left"
      ],
      "additionalProperties": false,
      "properties": {
        "expires_at": {
          "type": "string",
          "format": "date-time",
          "description": "Hạn của mã (2 phút)"
        },
        "attempts_left": {
          "type": "integer"
        },
        "simulated_sms": {
          "type": [
            "string",
            "null"
          ],
          "description": "Chỉ khi kênh gửi là SMS mô phỏng (bản demo): nội dung tin nhắn để app hiện trong khung 'SMS mô phỏng'. Kênh SMS thật không bao giờ trả trường này"
        }
      }
    },
    "OtpVerifyRequest": {
      "type": "object",
      "required": [
        "code"
      ],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[0-9]{6}$"
        }
      }
    },
    "OtpVerifyResponse": {
      "type": "object",
      "required": [
        "status",
        "attempts_left"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "pass",
            "retry"
          ]
        },
        "attempts_left": {
          "type": "integer",
          "description": "0 = đã khóa; muốn thử tiếp phải xin mã mới"
        }
      }
    },
    "IdCardFields": {
      "type": "object",
      "additionalProperties": false,
      "description": "Thông tin đọc từ QR của CCCD gắn chip",
      "properties": {
        "full_name": {
          "type": "string"
        },
        "id_number": {
          "type": "string",
          "pattern": "^[0-9]{12}$"
        },
        "date_of_birth": {
          "type": "string",
          "format": "date"
        },
        "sex": {
          "type": "string",
          "enum": [
            "Nam",
            "Nữ"
          ]
        },
        "address": {
          "type": "string"
        },
        "issued_on": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        }
      }
    },
    "IdCardResponse": {
      "type": "object",
      "required": [
        "status"
      ],
      "additionalProperties": false,
      "description": "Kết quả nhận ảnh CCCD. 'retry' chỉ nói về chất lượng ảnh hoặc QR, không kết luận thẻ thật/giả (phát hiện thẻ giả nằm ngoài phạm vi)",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "ok",
            "retry"
          ]
        },
        "fields": {
          "$ref": "#/$defs/IdCardFields"
        },
        "retry_hint": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            null,
            "QR_UNREADABLE",
            "QR_INVALID"
          ]
        }
      }
    },
    "IdCardConfirmResponse": {
      "type": "object",
      "required": [
        "received"
      ],
      "additionalProperties": false,
      "description": "Xác nhận đã nhận thông tin người dùng xác nhận/sửa. Sửa khác QR thì server ghi chú cho nhân viên duyệt; người dân không thấy kết luận nào",
      "properties": {
        "received": {
          "type": "boolean"
        }
      }
    },
    "ChallengeResponse": {
      "type": "object",
      "required": [
        "token",
        "expires_at",
        "challenge"
      ],
      "additionalProperties": false,
      "description": "Thử thách mới cho phần khuôn mặt, kèm hạn token đã gia hạn (ADR-0017 §2, giới hạn tổng của phiên)",
      "properties": {
        "token": {
          "type": "string",
          "description": "Token mới của phiên (gửi 'Authorization: Bearer' từ đây); token cũ hết hiệu lực"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time",
          "description": "Hạn mới của token"
        },
        "challenge": {
          "$ref": "#/$defs/Challenge"
        }
      }
    },
    "ErrorResponse": {
      "type": "object",
      "description": "Định dạng lỗi chung: 401 (thiếu Bearer, token sai hoặc hết hạn), 409 (bước đã nhận trong lượt này, hoặc sai thứ tự luồng: voice_not_requested khi finalize chưa yêu cầu đọc câu, session_closed khi phiên đã vào bàn duyệt), 422 (dữ liệu sai). Mã cho thử thách hết hạn do PLAT-06 chốt. Mã 409 thêm cho OTP/CCCD: otp_not_requested, otp_expired, otp_locked, otp_already_verified, otp_too_many (gửi mã quá 3 lần), id_card_not_received; session_too_long khi phiên quá giới hạn tổng. 503 flow_unavailable: luồng purpose chưa hỗ trợ đủ bộ kiểm chứng thật.",
      "required": [
        "error_code",
        "message"
      ],
      "additionalProperties": false,
      "properties": {
        "error_code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      }
    },
    "SessionPurpose": {
      "type": "string",
      "enum": [
        "onboarding",
        "reauth",
        "recovery"
      ]
    },
    "CreateSessionRequest": {
      "type": "object",
      "required": [
        "purpose",
        "nonce"
      ],
      "additionalProperties": false,
      "properties": {
        "purpose": {
          "$ref": "#/$defs/SessionPurpose"
        },
        "nonce": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{16,128}$",
          "description": "Mã tương quan do bên tích hợp cấp; không phải bằng chứng thiết bị hay chữ ký media."
        },
        "reference_image_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^ref_[A-Za-z0-9_-]{1,120}$",
          "description": "Mã ảnh do server quản lý; không nhận đường dẫn hoặc URL. Hiện chỉ là điểm nối cho FLOW-03/05, chưa xác minh danh tính."
        }
      },
      "description": "Gửi body để dùng luồng theo purpose (hiện chỉ hỗ trợ mock). Không gửi body giữ nguyên luồng MVP. Real/mixed trả 503 cho body mới tới khi đủ bộ kiểm chứng."
    },
    "GazePoint": {
      "type": "object",
      "required": [
        "x",
        "y",
        "at_ms"
      ],
      "additionalProperties": false,
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 0.9
        },
        "y": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 0.9
        },
        "at_ms": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "DynamicChallenge": {
      "type": "object",
      "required": [
        "version",
        "session_id",
        "nonce",
        "gaze_points",
        "head_turns",
        "head_start_at_ms",
        "head_duration_ms",
        "voice_start_at_ms",
        "voice_prompt",
        "voice_challenge_id",
        "frontal_capture_at_ms"
      ],
      "additionalProperties": false,
      "properties": {
        "version": {
          "type": "integer",
          "const": 1
        },
        "session_id": {
          "type": "string"
        },
        "nonce": {
          "type": "string"
        },
        "gaze_points": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/GazePoint"
          },
          "minItems": 8,
          "maxItems": 8
        },
        "head_turns": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "left",
              "right",
              "center"
            ]
          },
          "minItems": 3,
          "maxItems": 3
        },
        "head_start_at_ms": {
          "type": "integer",
          "minimum": 0
        },
        "head_duration_ms": {
          "type": "integer",
          "const": 6000
        },
        "voice_start_at_ms": {
          "type": "integer",
          "minimum": 0
        },
        "voice_prompt": {
          "type": "string"
        },
        "voice_challenge_id": {
          "type": "string"
        },
        "frontal_capture_at_ms": {
          "type": "integer",
          "minimum": 0
        }
      },
      "description": "Mọi at_ms tính từ đầu bản ghi giai đoạn B. Thu âm được bắt đầu theo lịch, không cần chờ finalize; chỉ gửi /voice sau khi finalize yêu cầu. Gói này là lệnh, không phải bằng chứng đã làm đúng."
    },
    "FinalizeRequest": {
      "type": "object",
      "required": [
        "challenge_id"
      ],
      "additionalProperties": false,
      "properties": {
        "challenge_id": {
          "type": "string"
        }
      },
      "description": "Bắt buộc với phiên có purpose; không gửi body cho MVP cũ."
    }
  }
}
