{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vericlue.local/schemas/credential.schema.json",
  "title": "BBS credential derived only from a committed server verification decision",
  "$defs": {
    "CredentialOfferRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commitment", "consent"],
      "properties": {
        "commitment": { "type": "string", "pattern": "^[A-Za-z0-9_-]{235}$" },
        "consent": { "type": "boolean", "const": true }
      }
    },
    "CredentialIssueRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commitment", "consent", "device_signature"],
      "properties": {
        "commitment": { "type": "string", "pattern": "^[A-Za-z0-9_-]{235}$" },
        "consent": { "type": "boolean", "const": true },
        "device_signature": {
          "type": "string",
          "minLength": 12,
          "maxLength": 108
        }
      }
    },
    "CredentialAuthorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "message", "expires_at"],
      "properties": {
        "algorithm": { "const": "ES256-DER" },
        "message": { "type": "string", "minLength": 80, "maxLength": 2048 },
        "expires_at": { "type": "integer", "minimum": 0, "maximum": 9999999999 }
      }
    },
    "CredentialKey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "key_id", "public_key"],
      "properties": {
        "algorithm": { "const": "BBS-BLS12-381-SHA-256-NYM" },
        "key_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "public_key": { "type": "string", "pattern": "^[A-Za-z0-9_-]{128}$" }
      }
    },
    "VerificationClaims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "issuer",
        "assurance",
        "verification_completed",
        "valid_from",
        "valid_until",
        "policy_version",
        "source_result_id",
        "account_id",
        "device_id",
        "source_purpose"
      ],
      "properties": {
        "protocol": { "const": "vericlue-private-verification-v1" },
        "issuer": { "type": "string", "pattern": "^[A-Za-z0-9:/._-]{1,200}$" },
        "assurance": { "const": "server-decision" },
        "verification_completed": { "type": "boolean", "const": true },
        "valid_from": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9999999999
        },
        "valid_until": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9999999999
        },
        "policy_version": { "const": "vericlue-session-result-v1" },
        "source_result_id": {
          "type": "string",
          "pattern": "^res_[a-f0-9]{64}$"
        },
        "account_id": { "type": "string", "pattern": "^acct_[a-f0-9]{32}$" },
        "device_id": { "type": "string", "pattern": "^dev_[a-f0-9]{32}$" },
        "source_purpose": { "enum": ["reauth", "recovery"] }
      }
    },
    "VerificationDisclosed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "issuer",
        "assurance",
        "verification_completed",
        "valid_from",
        "valid_until",
        "policy_version"
      ],
      "properties": {
        "protocol": { "const": "vericlue-private-verification-v1" },
        "issuer": { "type": "string", "pattern": "^[A-Za-z0-9:/._-]{1,200}$" },
        "assurance": { "const": "server-decision" },
        "verification_completed": { "type": "boolean", "const": true },
        "valid_from": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9999999999
        },
        "valid_until": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9999999999
        },
        "policy_version": { "const": "vericlue-session-result-v1" }
      }
    },
    "VerificationCredential": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claims", "signature", "signer_entropy", "key_id"],
      "properties": {
        "claims": { "$ref": "#/$defs/VerificationClaims" },
        "signature": { "type": "string", "pattern": "^[A-Za-z0-9_-]{107}$" },
        "signer_entropy": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "key_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "VerificationPresentation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "challenge_id",
        "disclosed",
        "proof",
        "pseudonym"
      ],
      "properties": {
        "protocol": { "const": "vericlue-private-verification-v1" },
        "challenge_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{22}$" },
        "disclosed": { "$ref": "#/$defs/VerificationDisclosed" },
        "proof": {
          "type": "string",
          "minLength": 363,
          "maxLength": 1000,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "pseudonym": { "type": "string", "pattern": "^[A-Za-z0-9_-]{64}$" }
      }
    }
  },
  "oneOf": [
    { "$ref": "#/$defs/CredentialOfferRequest" },
    { "$ref": "#/$defs/CredentialAuthorization" },
    { "$ref": "#/$defs/CredentialIssueRequest" },
    { "$ref": "#/$defs/CredentialKey" },
    { "$ref": "#/$defs/VerificationCredential" },
    { "$ref": "#/$defs/VerificationPresentation" }
  ]
}
