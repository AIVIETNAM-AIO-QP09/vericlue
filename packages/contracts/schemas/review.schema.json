{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vericlue.local/contracts/review.schema.json",
  "title": "Review API",
  "description": "Bàn duyệt của nhân viên. DRAFT v1: chỉ cho phép THÊM trường tùy chọn. ReviewCase (hồ sơ bằng chứng) KHÔNG chứa điểm AI; ý kiến AI nằm riêng ở ReviewAiOpinion và chỉ xem được sau khi nhân viên ghi quyết định ban đầu (GET .../ai trả 409 nếu chưa có).",
  "$defs": {
    "CaseStatus": { "type": "string", "enum": ["open", "initial_decided", "closed"] },
    "Priority": { "type": "string", "enum": ["normal", "high"] },
    "Decision": { "type": "string", "enum": ["accept", "reject", "request_retry"] },
    "MediaRef": {
      "type": "object",
      "required": ["kind", "url"],
      "additionalProperties": false,
      "properties": {
        "kind": { "type": "string", "enum": ["face_image", "face_video", "voice_audio"] },
        "url": { "type": "string" }
      }
    },
    "ReviewCaseSummary": {
      "type": "object",
      "required": ["case_id", "session_id", "status", "priority", "created_at"],
      "additionalProperties": false,
      "properties": {
        "case_id": { "type": "string" },
        "session_id": { "type": "string" },
        "status": { "$ref": "#/$defs/CaseStatus" },
        "priority": { "$ref": "#/$defs/Priority" },
        "created_at": { "type": "string", "format": "date-time" }
      }
    },
    "ReviewCaseList": {
      "type": "object",
      "required": ["items"],
      "additionalProperties": false,
      "properties": {
        "items": { "type": "array", "items": { "$ref": "#/$defs/ReviewCaseSummary" } }
      }
    },
    "ReviewCase": {
      "type": "object",
      "description": "Hồ sơ bằng chứng KHÔNG kèm điểm AI: tuyệt đối không có score, prob_attack hay kết quả từng mô-đun.",
      "required": ["case_id", "session_id", "status", "priority", "created_at", "media"],
      "additionalProperties": false,
      "properties": {
        "case_id": { "type": "string" },
        "session_id": { "type": "string" },
        "status": { "$ref": "#/$defs/CaseStatus" },
        "priority": { "$ref": "#/$defs/Priority" },
        "created_at": { "type": "string", "format": "date-time" },
        "media": { "type": "array", "items": { "$ref": "#/$defs/MediaRef" } },
        "capture_notes": { "type": "array", "items": { "type": "string" }, "description": "Ghi chú về điều kiện chụp (ánh sáng, thiết bị), không phải kết luận AI" },
        "initial_decision": { "oneOf": [{ "$ref": "#/$defs/Decision" }, { "type": "null" }] },
        "final_decision": { "oneOf": [{ "$ref": "#/$defs/Decision" }, { "type": "null" }] },
        "history": { "type": "array", "items": { "$ref": "#/$defs/ReviewEvent" }, "description": "Lịch sử quyết định của ca, theo thứ tự ghi. Không có điểm AI." }
      }
    },
    "ReviewEvent": {
      "type": "object",
      "description": "Một dòng trong nhật ký ca (chỉ ghi thêm, nối chuỗi băm). Không chứa điểm AI.",
      "required": ["action", "decision", "actor", "created_at"],
      "additionalProperties": false,
      "properties": {
        "action": { "type": "string", "enum": ["initial", "final"] },
        "decision": { "$ref": "#/$defs/Decision" },
        "reason_code": { "type": ["string", "null"] },
        "note": { "type": ["string", "null"] },
        "actor": { "type": "string", "description": "Tạm 'staff-unverified' cho tới khi PLAT-06 có xác thực nhân viên" },
        "created_at": { "type": "string", "format": "date-time" }
      }
    },
    "ReasonCode": {
      "type": "object",
      "required": ["code", "label", "note_required"],
      "additionalProperties": false,
      "properties": {
        "code": { "type": "string" },
        "label": { "type": "string" },
        "note_required": { "type": "boolean" }
      }
    },
    "ReasonCodeList": {
      "type": "object",
      "description": "Mã lý do hợp lệ cho quyết định cuối (danh sách tạm — M2 chỉnh). reason_code ngoài danh sách bị từ chối 422 invalid_reason_code.",
      "required": ["items"],
      "additionalProperties": false,
      "properties": {
        "items": { "type": "array", "items": { "$ref": "#/$defs/ReasonCode" } }
      }
    },
    "AuditVerification": {
      "type": "object",
      "description": "Kết quả kiểm chuỗi băm của một ca.",
      "required": ["case_id", "ok", "checked"],
      "additionalProperties": false,
      "properties": {
        "case_id": { "type": "string" },
        "ok": { "type": "boolean" },
        "checked": { "type": "integer" },
        "bad_index": { "type": ["integer", "null"] },
        "reason": { "type": ["string", "null"] }
      }
    },
    "InitialDecisionRequest": {
      "type": "object",
      "required": ["decision"],
      "additionalProperties": false,
      "properties": {
        "decision": { "$ref": "#/$defs/Decision" },
        "note": { "type": "string" }
      }
    },
    "ReviewAiOpinion": {
      "type": "object",
      "description": "Ý kiến AI cho nhân viên (có điểm). Chỉ trả sau khi có quyết định ban đầu.",
      "required": ["case_id", "suggestion", "modules"],
      "additionalProperties": false,
      "properties": {
        "case_id": { "type": "string" },
        "suggestion": { "type": "string", "enum": ["pass", "review", "retry"] },
        "modules": { "type": "array", "items": { "$ref": "https://vericlue.local/contracts/module_result.schema.json" } }
      }
    },
    "FinalDecisionRequest": {
      "type": "object",
      "required": ["decision", "reason_code"],
      "additionalProperties": false,
      "properties": {
        "decision": { "$ref": "#/$defs/Decision" },
        "reason_code": { "type": "string", "description": "Mã trong GET /v1/review/reason-codes; OTHER bắt buộc có note" },
        "note": { "type": "string" }
      }
    },
    "DecisionResponse": {
      "type": "object",
      "required": ["case_id", "status"],
      "additionalProperties": false,
      "properties": {
        "case_id": { "type": "string" },
        "status": { "$ref": "#/$defs/CaseStatus" }
      }
    }
  }
}
