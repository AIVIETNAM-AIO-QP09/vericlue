{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vericlue.local/schemas/private_credential.schema.json",
  "title": "LIVE-05 experimental local credential protocol; never an eKYC verdict",
  "$defs": {
    "Format": { "enum": ["bbs-nym", "sd-jwt-kb", "jwt-pop"] },
    "Claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "issuer",
        "assurance",
        "valid_from",
        "valid_until",
        "verified",
        "age_over_18",
        "full_name",
        "id_number",
        "birth_date",
        "policy_version"
      ],
      "properties": {
        "protocol": { "const": "vericlue-private-credential-lab-v1" },
        "issuer": { "const": "vericlue-lab" },
        "assurance": { "const": "synthetic-demo" },
        "valid_from": { "type": "integer", "minimum": 0 },
        "valid_until": { "type": "integer", "minimum": 0 },
        "verified": { "type": "boolean" },
        "age_over_18": { "type": "boolean" },
        "full_name": { "enum": ["Demo Adult", "Demo Minor"] },
        "id_number": { "enum": ["DEMO-ADULT", "DEMO-MINOR"] },
        "birth_date": { "enum": ["2000-01-01", "2015-01-01"] },
        "policy_version": { "const": "lab-policy-v1" }
      }
    },
    "Offer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commitment"],
      "properties": {
        "commitment": { "type": "string", "pattern": "^[A-Za-z0-9_-]{235}$" }
      }
    },
    "BbsCredential": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claims", "signature", "signer_entropy"],
      "properties": {
        "claims": { "$ref": "#/$defs/Claims" },
        "signature": { "type": "string", "pattern": "^[A-Za-z0-9_-]{107}$" },
        "signer_entropy": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "Challenge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "nonce",
        "audience",
        "format",
        "policy",
        "issued_at",
        "expires_at"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{22}$" },
        "nonce": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" },
        "audience": { "type": "string", "minLength": 9, "maxLength": 200 },
        "format": { "$ref": "#/$defs/Format" },
        "policy": { "enum": ["verified", "adult"] },
        "issued_at": { "type": "integer", "minimum": 0 },
        "expires_at": { "type": "integer", "minimum": 0 }
      }
    },
    "DisclosedClaims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "issuer",
        "assurance",
        "valid_from",
        "valid_until",
        "verified",
        "policy_version"
      ],
      "properties": {
        "protocol": { "const": "vericlue-private-credential-lab-v1" },
        "issuer": { "const": "vericlue-lab" },
        "assurance": { "const": "synthetic-demo" },
        "valid_from": { "type": "integer", "minimum": 0 },
        "valid_until": { "type": "integer", "minimum": 0 },
        "verified": { "type": "boolean" },
        "age_over_18": { "type": "boolean" },
        "policy_version": { "const": "lab-policy-v1" }
      }
    },
    "BbsPresentation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "challenge_id", "disclosed", "proof", "pseudonym"],
      "properties": {
        "format": { "const": "bbs-nym" },
        "challenge_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{22}$" },
        "disclosed": { "$ref": "#/$defs/DisclosedClaims" },
        "proof": {
          "type": "string",
          "minLength": 363,
          "maxLength": 1000,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "pseudonym": { "type": "string", "pattern": "^[A-Za-z0-9_-]{64}$" }
      }
    },
    "TokenPresentation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "challenge_id", "token"],
      "properties": {
        "format": { "enum": ["sd-jwt-kb", "jwt-pop"] },
        "challenge_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{22}$" },
        "token": {
          "type": "string",
          "minLength": 100,
          "maxLength": 16384,
          "pattern": "^[A-Za-z0-9_.~-]+$"
        }
      }
    }
  },
  "oneOf": [
    { "$ref": "#/$defs/Offer" },
    { "$ref": "#/$defs/BbsCredential" },
    { "$ref": "#/$defs/Challenge" },
    { "$ref": "#/$defs/BbsPresentation" },
    { "$ref": "#/$defs/TokenPresentation" }
  ]
}
