# Sao chép thành .env rồi điền giá trị. KHÔNG commit file .env.

# ── Cơ sở dữ liệu ───────────────────────────────
POSTGRES_USER=vericlue
POSTGRES_PASSWORD=change-me
POSTGRES_DB=vericlue
DATABASE_URL=postgresql+psycopg://vericlue:change-me@localhost:5432/vericlue

# ── API ─────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:3000
# Khóa ký token phiên và báo cáo (tạo bằng: uv run python scripts/gen_keys.py)
SESSION_SIGNING_SECRET=change-me
REPORT_SIGNING_KEY_PATH=secrets/report_ed25519.key

# ── Mô hình ─────────────────────────────────────
MODELS_DIR=./models
DEVICE=cpu                # cpu | cuda
USE_MOCK_MODELS=true      # true: dùng mô-đun giả lập (chưa cần tải mô hình)

# ── Lưu file tạm ────────────────────────────────
MEDIA_DIR=./tmp/media
MEDIA_TTL_PASS_HOURS=24
MEDIA_TTL_REVIEW_DAYS=30

# ── Web ─────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Hugging Face (chỉ cần khi tải bộ dữ liệu có cổng đăng ký) ──
HF_TOKEN=

# ── Dữ liệu (DATA-01; dùng chung giữa worktree) ──
DATA_DIR=./data
# Ví dụ kho dùng chung ngoài worktree: DATA_DIR=E:\shared\vericlue\data
# Kaggle: dùng hai biến này hoặc ~/.kaggle/kaggle.json; không commit credentials.
KAGGLE_USERNAME=
KAGGLE_KEY=

# --- API v1 (PLAT-04) ---
SESSION_TTL_SECONDS=300
CHALLENGE_TTL_SECONDS=120
MAX_RETRIES=2
MAX_UPLOAD_MB=50
CHALLENGE_PALETTE="#ffcc73,#73d9ff,#ffb3eb,#80e09e"
# TẠM — ROUT-02 thay bằng ngưỡng khóa trong ml/configs/thresholds.yaml
PROVISIONAL_THRESHOLD_B=0.15
PROVISIONAL_THRESHOLD_A=0.60
