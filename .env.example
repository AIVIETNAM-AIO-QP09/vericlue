# Sao chép thành .env rồi điền giá trị. KHÔNG commit file .env.

# ── Cơ sở dữ liệu ───────────────────────────────
POSTGRES_USER=vericlue
POSTGRES_PASSWORD=change-me
POSTGRES_DB=vericlue
DATABASE_URL=postgresql+psycopg://vericlue:change-me@127.0.0.1:5432/vericlue

# ── API ─────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:3000
# Khóa ký token phiên và báo cáo (tạo bằng: uv run python scripts/gen_keys.py)
# Khóa ngẫu nhiên >= 32 byte. Để trống chỉ dùng được với USE_MOCK_MODELS=true.
SESSION_SIGNING_SECRET=
REPORT_SIGNING_KEY_PATH=secrets/report_ed25519.key
# Kết quả xác minh cho bên tích hợp (Ed25519, opt-in; không mở luồng sinh trắc thật).
# Chạy gen_keys.py; dùng khóa trong secrets/server-signing/. Không tự áp dụng vào API.
RESULT_SIGNING_KEY_FILE=
RESULT_ISSUER=
RESULT_AUDIENCE=
RESULT_TTL_SECONDS=60

# ── Mô hình ─────────────────────────────────────
MODELS_DIR=./models
DEVICE=cpu                # cpu | cuda | auto (không có GPU/runtime thì tự lùi CPU và ghi log; GPU cần `--extra cuda`)
LIPSYNC_DEVICE=cpu        # cpu (mặc định) | cuda | auto; riêng SyncNet + CTC + SCRFD lipsync, nạp lần dùng đầu
ROUTER_PROFILE=full      # full (mặc định) | mvp (ADR-0012 §6: 7 module, lipsync tham khảo)
USE_MOCK_MODELS=true      # true: mọi module mock | false: mọi module thật | mixed: module có mô hình thật
                          # dùng thật (hiện: quality, face_pad, face_deepfake, camprobe, voice_challenge, voice_spoof, lipsync), còn lại mock.
                          # mixed cần `--extra face --extra gend --extra voice` (hoặc `--extra cuda`).

# ── Lưu file tạm ────────────────────────────────
MEDIA_DIR=./tmp/media
MEDIA_TTL_PASS_HOURS=24
MEDIA_TTL_REVIEW_DAYS=30
MEDIA_TTL_INCOMPLETE_HOURS=24
MEDIA_CLEANUP_INTERVAL_SECONDS=300
# Để trống = KHÔNG tự xóa chứng cứ giám định. Chỉ bật sau khi nhóm chốt chính sách.
FORENSIC_TTL_DAYS=
# Chạy fetch_web_assets.py trên host trước khi dùng camera lab, không bake model vào image.
WEB_ASSETS_DIR=./apps/web/public/mediapipe

# ── Web ─────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Hugging Face (chỉ cần khi tải bộ dữ liệu có cổng đăng ký) ──
HF_TOKEN=

# ── Dữ liệu (DATA-01; dùng chung giữa worktree) ──
DATA_DIR=./data
# Ví dụ kho dùng chung ngoài worktree: DATA_DIR=E:\shared\vericlue\data
# Kaggle: dùng hai biến này hoặc ~/.kaggle/kaggle.json; không commit credentials.
KAGGLE_USERNAME=
KAGGLE_KEY=

# --- API v1 (PLAT-04) ---
SESSION_TTL_SECONDS=300
CHALLENGE_TTL_SECONDS=120
MAX_RETRIES=2
MAX_UPLOAD_MB=50
# Bảng màu mặc định nằm ở packages/contracts/chromapulse.json; chỉ đặt biến này để ghi đè khi thử.
# CHALLENGE_PALETTE=
# Ngưỡng khóa dùng chung API/ML; để trống dùng ml/configs/thresholds.yaml.
# THRESHOLDS_CONFIG=

# Đường dẫn tới packages/contracts/chromapulse.json khi cấu trúc thư mục khác repo (ví dụ ảnh Docker).
# CHROMAPULSE_CONFIG=

# PLAT-08: deadline chung cho mỗi nhóm detector, tối đa 4s để giữ ngân sách endpoint 5s.
DETECTOR_TIMEOUT_SECONDS=4
DETECTOR_WORKERS=9
# Số task chờ mỗi module, ngoài một task đang chạy; 0 = không xếp hàng.
DETECTOR_QUEUE_SIZE=3
# Ngân sách inference tính từ trước khi chờ khóa DB; tối đa 4,8 giây.
INFERENCE_BUDGET_SECONDS=4.8
# PostgreSQL: giới hạn chờ mỗi khóa trong transaction finalize/voice; hết giờ -> 503 storage_busy.
DB_LOCK_TIMEOUT_SECONDS=2
# Nếu chạy wheel ngoài cấu trúc repo; Dockerfile đã đặt đường dẫn tới config được chép.
# ML_MODELS_CONFIG=

# FLOW-05: so cùng người mặt–giọng, opt-in; cần IDENTITY_LAB_URL và IDENTITY_FACE_FROM_VIDEO=true.
# Cần ký media cả mặt/giọng; xem docs/architecture/face-voice-continuity.md.
IDENTITY_VOICE_CONTINUITY=false
# Internal enrollment after a fully verified onboarding pass. Never enables real/mixed flows.
ACCOUNT_ENROLLMENT=false
# IDENTITY_VOICE_CALIBRATION=
